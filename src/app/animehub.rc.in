#include <winver.h>

#pragma code_page(65001)

IDI_ICON1 ICON "@CMAKE_SOURCE_DIR@/assets/animehub.ico"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
  PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
  FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
  FILEFLAGS VS_FF_DEBUG
#else
  FILEFLAGS 0x0L
#endif
  FILEOS VOS_NT_WINDOWS32
  FILETYPE VFT_APP
  FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "AnimeHub"
      VALUE "FileDescription", "AnimeHub Desktop"
      VALUE "FileVersion", "@PROJECT_VERSION@.0"
      VALUE "InternalName", "AnimeHub"
      VALUE "LegalCopyright", "Copyright (C) AnimeHub Contributors (GPL-3.0-or-later)"
      VALUE "OriginalFilename", "AnimeHub.exe"
      VALUE "ProductName", "AnimeHub"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
